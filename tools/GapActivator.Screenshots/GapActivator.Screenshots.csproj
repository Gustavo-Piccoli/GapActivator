<Project Sdk="Microsoft.NET.Sdk">

  <!-- Renders the README screenshots with a headless Avalonia session. A developer tool: no tests, never packed or published. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <PublishAot>false</PublishAot>
    <RootNamespace>GapActivator.Screenshots</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GapActivator.App\GapActivator.App.csproj" />
  </ItemGroup>

</Project>
