<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Ical.Net" Version="5.2.4" />
    <!-- Embedded relational storage with migrations (spec section 3). -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <!-- Migrations tooling only; referenced with PrivateAssets="all". -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <!-- The Windows Service host (spec section 3). -->
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
    <!-- Event Log for severe service errors (spec section 9). -->
    <PackageVersion Include="Microsoft.Extensions.Logging.EventLog" Version="10.0.14" />
    <!-- DPAPI on .NET for machine-scope secrets (spec sections 3 and 9). -->
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <!-- SMTP with TLS and authentication (spec section 3). -->
    <PackageVersion Include="MailKit" Version="4.18.2" />
    <!-- Exact pin of a transitive dependency of MailKit 4.18.1: its default 10.0.0 is flagged by NuGet audit. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <!-- Desktop UI, the same as the GapMouse sibling app (spec section 3). -->
    <PackageVersion Include="Avalonia" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <!-- Headless platform for the view tests and the screenshot tool; never referenced by the app. -->
    <PackageVersion Include="Avalonia.Headless" Version="12.1.4" />
    <!-- Source-generated MVVM, the same as GapMouse. -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
</Project>
