<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GapActivator.App.ViewModels"
             x:Class="GapActivator.App.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
  <!--
    Operate surface: the state of the installation first (connection, rights, pause), then what is running, what comes
    next, and what went wrong. No state rests on color alone: connection and failures carry a glyph and text, "New" is a word.
    Every empty list says so, and nothing claims "none" before the service has reported once.
  -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="20" MaxWidth="880" HorizontalAlignment="Stretch">

      <Border Classes="card" Padding="20,16">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Classes="railIcon" Text="{Binding ConnectionGlyph}" />
              <TextBlock Classes="group" Text="{Binding ConnectionText}" TextWrapping="Wrap" VerticalAlignment="Center"
                         AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <TextBlock Text="{Binding CallerText}" TextWrapping="Wrap"
                       IsVisible="{Binding CallerText, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Classes="caption" Text="{Binding OperatorsModeText}" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"
                       IsVisible="{Binding OperatorsModeText, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0" IsVisible="{Binding IsPaused}">
              <TextBlock Classes="railIcon warning" Text="&#xE769;" />
              <TextBlock Classes="warning" Text="{Binding PausedText}" TextWrapping="Wrap" VerticalAlignment="Center"
                         AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top">
            <Button x:Name="PauseButton" Content="{Binding L.Pause}" Command="{Binding PauseCommand}"
                    IsVisible="{Binding !IsPaused}"
                    ToolTip.Tip="{Binding Permissions.DeniedReason}" ToolTip.ShowOnDisabled="True" />
            <Button x:Name="ResumeButton" Classes="accent" Content="{Binding L.Resume}" Command="{Binding ResumeCommand}"
                    IsVisible="{Binding IsPaused}"
                    ToolTip.Tip="{Binding Permissions.DeniedReason}" ToolTip.ShowOnDisabled="True" />
          </StackPanel>
        </Grid>
      </Border>

      <TextBlock Classes="error" Text="{Binding ErrorText}" TextWrapping="Wrap"
                 IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}"
                 AutomationProperties.LiveSetting="Assertive" />

      <TextBlock Classes="muted" Text="{Binding L.WaitingForService}" TextWrapping="Wrap" IsVisible="{Binding !HasData}" />

      <StackPanel Spacing="20" IsVisible="{Binding HasData}">

        <Border Classes="card">
          <StackPanel>
            <TextBlock x:Name="ActiveRunsHeading" Classes="group" Text="{Binding L.ActiveRunsHeading}" Margin="16,14,16,4" />
            <TextBlock Classes="muted" Text="{Binding L.NoActiveRuns}" Margin="16,4,16,16" IsVisible="{Binding !HasActiveRuns}" />
            <ItemsControl x:Name="ActiveRuns" ItemsSource="{Binding ActiveRuns}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ActiveRunItemViewModel">
                  <Grid Classes="row" ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{Binding StateText}" Foreground="{DynamicResource GaAccentTextBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="6"
                                    IsVisible="{Binding StartedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                          <TextBlock Classes="caption" Text="{Binding L.StartedLabel}" VerticalAlignment="Center" />
                          <TextBlock Classes="caption" Text="{Binding StartedText}" VerticalAlignment="Center" />
                        </StackPanel>
                      </StackPanel>
                    </StackPanel>
                    <Button x:Name="CancelRun" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                            Content="{Binding ActionText}" Command="{Binding CancelCommand}"
                            AutomationProperties.Name="{Binding ActionAutomationName}"
                            ToolTip.Tip="{Binding DeniedReason}" ToolTip.ShowOnDisabled="True" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel>
            <TextBlock x:Name="UpcomingHeading" Classes="group" Text="{Binding L.UpcomingHeading}" Margin="16,14,16,4" />
            <TextBlock Classes="muted" Text="{Binding L.NoUpcomingRuns}" Margin="16,4,16,16" IsVisible="{Binding !HasUpcoming}" />
            <ItemsControl x:Name="Upcoming" ItemsSource="{Binding Upcoming}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:UpcomingItem">
                  <Grid Classes="row" ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding ProcessName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="caption" Text="{Binding AtText}" Margin="16,0,0,0" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel>
            <TextBlock x:Name="RecentFailuresHeading" Classes="group" Text="{Binding L.RecentFailuresHeading}" Margin="16,14,16,4" />
            <TextBlock Classes="muted" Text="{Binding L.NoRecentFailures}" Margin="16,4,16,16" IsVisible="{Binding !HasRecentFailures}" />
            <ItemsControl x:Name="RecentFailures" ItemsSource="{Binding RecentFailures}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FailureItemViewModel">
                  <Button Classes="row" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding AutomationName}">
                    <Grid Classes="row" ColumnDefinitions="Auto,*,Auto,Auto">
                      <TextBlock Grid.Column="0" Classes="railIcon error" Text="&#xE7BA;" Margin="0,0,12,0" />
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="error" Text="{Binding OutcomeText}" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Classes="caption" Text="{Binding EndedText}" Margin="16,0,0,0" VerticalAlignment="Center" />
                      <Border Grid.Column="3" Classes="badge blocked" Margin="12,0,0,0" VerticalAlignment="Center"
                              IsVisible="{Binding IsUnseen}">
                        <TextBlock Classes="caption" Text="{Binding L.UnseenLabel}" />
                      </Border>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
