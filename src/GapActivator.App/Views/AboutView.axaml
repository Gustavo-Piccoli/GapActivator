<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GapActivator.App.ViewModels"
             x:Class="GapActivator.App.Views.AboutView"
             x:DataType="vm:AboutViewModel"
             Classes="about">
  <!--
    Operate surface, one calm column of cards: what this is and which version, the update check, the source code, who may change
    things, and where the files are. The update status and a failed folder open are announced politely. Folder rows say what they
    open in their accessible name (the visible button text alone would be the same four times). Paths are selectable and trimmed
    from the left so the folder name at the end stays visible; the full path is in the tooltip. Tab order is XAML order. Nothing is
    shown by color alone, and keyboard focus uses the app's focus ring (see Controls.axaml).
  -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="16" MaxWidth="880" HorizontalAlignment="Stretch" Margin="0,0,12,0">

      <StackPanel Spacing="2">
        <TextBlock Classes="title" Text="{Binding L.AppName}" AutomationProperties.HeadingLevel="1" />
        <TextBlock x:Name="VersionLine" Classes="muted" Text="{Binding VersionLabel}" />
        <TextBlock x:Name="ServiceVersionLine" Classes="muted" Text="{Binding ServiceVersionText}"
                   IsVisible="{Binding ServiceVersionText, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>

      <Grid x:Name="DevelopmentNoteRow" ColumnDefinitions="Auto,*" ColumnSpacing="10" IsVisible="{Binding IsDevelopmentMode}">
        <TextBlock Grid.Column="0" Classes="railIcon warning" Text="&#xE7BA;" />
        <TextBlock Grid.Column="1" Classes="warning" Text="{Binding DevelopmentNote}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </Grid>

      <!-- Updates -->
      <Border Classes="card" Padding="16">
        <StackPanel Spacing="10">
          <TextBlock Classes="group" Text="{Binding L.AboutUpdatesLabel}" AutomationProperties.HeadingLevel="2" />
          <TextBlock x:Name="UpdateStatusText" Text="{Binding UpdateStatus}" TextWrapping="Wrap"
                     AutomationProperties.LiveSetting="Polite" />
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"
                IsVisible="{Binding AutomaticChecksNote, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Grid.Column="0" Classes="railIcon" Text="&#xE946;" />
            <TextBlock x:Name="AutomaticChecksNoteText" Grid.Column="1" Classes="muted" Text="{Binding AutomaticChecksNote}"
                       TextWrapping="Wrap" VerticalAlignment="Center" />
          </Grid>
          <WrapPanel Orientation="Horizontal">
            <Button x:Name="CheckNowButton" Classes="accent" Content="{Binding L.AboutCheckNow}" Command="{Binding CheckNowCommand}"
                    Margin="0,0,12,0" />
            <Button x:Name="OpenReleaseButton" Content="{Binding L.AboutOpenRelease}" Command="{Binding OpenReleaseCommand}"
                    AutomationProperties.Name="{Binding OpenReleaseName}"
                    IsVisible="{Binding AvailableReleaseUrl, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </WrapPanel>
          <Grid x:Name="ReleaseErrorRow" ColumnDefinitions="Auto,*" ColumnSpacing="10"
                IsVisible="{Binding ReleaseErrorText, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Grid.Column="0" Classes="railIcon error" Text="&#xE783;" />
            <TextBlock x:Name="ReleaseErrorText" Grid.Column="1" Classes="error" Text="{Binding ReleaseErrorText}" TextWrapping="Wrap"
                       VerticalAlignment="Center" AutomationProperties.LiveSetting="Assertive" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Source code -->
      <Border Classes="card" Padding="16">
        <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="6">
          <TextBlock Grid.Row="0" Grid.Column="0" Classes="group" Text="{Binding L.AboutRepositoryLabel}" AutomationProperties.HeadingLevel="2" />
          <SelectableTextBlock x:Name="RepositoryText" Grid.Row="1" Grid.Column="0" Classes="muted" Text="{Binding RepositoryUrl}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RepositoryUrl}"
                               VerticalAlignment="Center" />
          <Button x:Name="OpenRepositoryButton" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Content="{Binding L.AboutOpenRepository}"
                  Command="{Binding OpenRepositoryCommand}" AutomationProperties.Name="{Binding OpenRepositoryName}"
                  VerticalAlignment="Center" />
        </Grid>
        <Grid x:Name="RepositoryErrorRow" ColumnDefinitions="Auto,*" ColumnSpacing="10"
              IsVisible="{Binding RepositoryErrorText, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Grid.Column="0" Classes="railIcon error" Text="&#xE783;" />
          <TextBlock x:Name="RepositoryErrorText" Grid.Column="1" Classes="error" Text="{Binding RepositoryErrorText}" TextWrapping="Wrap"
                     VerticalAlignment="Center" AutomationProperties.LiveSetting="Assertive" />
        </Grid>
        </StackPanel>
      </Border>

      <!-- Who may change things -->
      <Border x:Name="AuthorizationCard" Classes="card" Padding="16"
              IsVisible="{Binding AuthorizationText, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel Spacing="8">
          <TextBlock Classes="group" Text="{Binding L.AuthorizationLabel}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="2" />
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <TextBlock Grid.Column="0" Classes="railIcon" Text="&#xE946;" />
            <TextBlock x:Name="AuthorizationText" Grid.Column="1" Classes="muted" Text="{Binding AuthorizationText}"
                       TextWrapping="Wrap" VerticalAlignment="Center" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Where the files are -->
      <Border Classes="card" Padding="0">
        <StackPanel>
          <StackPanel Margin="16,16,16,4" Spacing="4">
            <TextBlock Classes="group" Text="{Binding L.AboutFilesLabel}" AutomationProperties.HeadingLevel="2" />
            <TextBlock Classes="caption" Text="{Binding L.AboutServiceNote}" TextWrapping="Wrap" />
            <Grid x:Name="FolderErrorRow" ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,6,0,0"
                  IsVisible="{Binding FolderErrorText, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock Grid.Column="0" Classes="railIcon error" Text="&#xE783;" />
              <TextBlock x:Name="FolderErrorText" Grid.Column="1" Classes="error" Text="{Binding FolderErrorText}" TextWrapping="Wrap"
                         VerticalAlignment="Center" AutomationProperties.LiveSetting="Assertive" />
            </Grid>
          </StackPanel>

          <Grid Classes="row" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="2">
            <TextBlock Grid.Row="0" Text="{Binding L.AboutServiceDataLabel}" FontWeight="SemiBold" />
            <SelectableTextBlock x:Name="ServiceDataText" Grid.Row="1" Classes="caption" Text="{Binding ServiceDataRoot}"
                                 TextWrapping="NoWrap" TextTrimming="LeadingCharacterEllipsis" ToolTip.Tip="{Binding ServiceDataRoot}" />
            <Button x:Name="OpenServiceDataButton" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Content="{Binding L.AboutOpenFolder}"
                    Command="{Binding OpenFolderCommand}" CommandParameter="{Binding ServiceDataRoot}"
                    AutomationProperties.Name="{Binding ServiceDataName}" VerticalAlignment="Center" />
          </Grid>
          <Border Classes="divider" />
          <Grid Classes="row" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="2">
            <TextBlock Grid.Row="0" Text="{Binding L.AboutServiceLogsLabel}" FontWeight="SemiBold" />
            <SelectableTextBlock x:Name="ServiceLogsText" Grid.Row="1" Classes="caption" Text="{Binding ServiceLogs}"
                                 TextWrapping="NoWrap" TextTrimming="LeadingCharacterEllipsis" ToolTip.Tip="{Binding ServiceLogs}" />
            <Button x:Name="OpenServiceLogsButton" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Content="{Binding L.AboutOpenFolder}"
                    Command="{Binding OpenFolderCommand}" CommandParameter="{Binding ServiceLogs}"
                    AutomationProperties.Name="{Binding ServiceLogsName}" VerticalAlignment="Center" />
          </Grid>
          <Border Classes="divider" />
          <Grid Classes="row" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="2">
            <TextBlock Grid.Row="0" Text="{Binding L.AboutAppSettingsLabel}" FontWeight="SemiBold" />
            <SelectableTextBlock x:Name="AppSettingsText" Grid.Row="1" Classes="caption" Text="{Binding AppSettingsFile}"
                                 TextWrapping="NoWrap" TextTrimming="LeadingCharacterEllipsis" ToolTip.Tip="{Binding AppSettingsFile}" />
            <Button x:Name="OpenAppSettingsButton" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Content="{Binding L.AboutOpenFolder}"
                    Command="{Binding OpenFolderCommand}" CommandParameter="{Binding AppSettingsFolder}"
                    AutomationProperties.Name="{Binding AppSettingsName}" VerticalAlignment="Center" />
          </Grid>
          <Border Classes="divider" />
          <Grid Classes="row" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="2">
            <TextBlock Grid.Row="0" Text="{Binding L.AboutAppLogsLabel}" FontWeight="SemiBold" />
            <SelectableTextBlock x:Name="AppLogsText" Grid.Row="1" Classes="caption" Text="{Binding AppLogs}"
                                 TextWrapping="NoWrap" TextTrimming="LeadingCharacterEllipsis" ToolTip.Tip="{Binding AppLogs}" />
            <Button x:Name="OpenAppLogsButton" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Content="{Binding L.AboutOpenFolder}"
                    Command="{Binding OpenFolderCommand}" CommandParameter="{Binding AppLogs}"
                    AutomationProperties.Name="{Binding AppLogsName}" VerticalAlignment="Center" />
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
