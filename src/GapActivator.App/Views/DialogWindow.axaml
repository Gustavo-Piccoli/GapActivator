<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GapActivator.App.ViewModels"
        x:Class="GapActivator.App.Views.DialogWindow"
        x:DataType="vm:DialogViewModel"
        Title="{Binding Title}"
        Width="440" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24" Spacing="16">
    <TextBlock Classes="group" Text="{Binding Title}" TextWrapping="Wrap" />
    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <!-- No default button: Enter must not confirm a destructive question. Focus starts on the safe button. -->
      <Button x:Name="PrimaryButton" Classes="accent" MinWidth="88" HorizontalContentAlignment="Center"
              Content="{Binding Primary}" Click="OnPrimary" />
      <Button x:Name="SecondaryButton" MinWidth="88" HorizontalContentAlignment="Center" Content="{Binding Secondary}"
              IsVisible="{Binding HasSecondary}" Click="OnSecondary" />
      <Button x:Name="CancelButton" MinWidth="88" HorizontalContentAlignment="Center" Content="{Binding Cancel}" Click="OnCancel" />
    </StackPanel>
  </StackPanel>
</Window>
